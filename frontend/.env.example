# Copy this file to ".env.local" to change the settings locally (never commit .env.local).

# true  = the site uses labelled demo data (no backend needed)
# false = the site calls the team FastAPI backend
VITE_USE_MOCKS=true

# Base path of the team API (see docs/API_CONTRACTS.md)
VITE_API_BASE_URL=/api/v1
