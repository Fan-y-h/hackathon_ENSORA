# Public values only - never put secrets here (docs/DEPLOYMENT.md).
# Leave empty to use the Vite dev proxy (/api -> VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=
# Backend used by the dev proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Server-side only (no VITE_ prefix, never sent to the browser): token file of the P1 sources
# API. Default: <LOCAL_DATA_DIR or ~/.local/share/ensora-plus>/api-token
# ENSORA_P1_TOKEN_FILE=
